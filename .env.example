# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# For Development (local MySQL - no password)
DEV_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/network_slicing

# For Production (change these values)
DATABASE_URL=mysql+pymysql://prod_user:prod_password@prod-host:3306/network_slicing_prod

# Email Configuration (SMTP)
# Option 1: Gmail (requires App Password, not regular password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password-not-gmail-password

# Option 2: Corporate SMTP
# MAIL_SERVER=smtp.company.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@company.com
# MAIL_PASSWORD=your-password

# Option 3: Local development (MailHog - for testing)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# Email Sender
MAIL_DEFAULT_SENDER=noreply@networkslicing.com

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True

# Application Metadata
APP_NAME=Network Slicing Dashboard
APP_DEBUG_MODE=False
